# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/imprimantcloud"

# Clé de chiffrement AES-256-GCM pour les UserKEY xpyun
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="<64-chars-hex>"

# Mode debug xpyun : "1" = ne consomme pas de papier, "0" = production
XPYUN_DEBUG="0"
